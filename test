<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Persistent Location Tracker</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .container {
            max-width: 500px;
            width: 100%;
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }
        
        h1 {
            text-align: center;
            color: #333;
            margin-bottom: 5px;
            font-size: 24px;
        }
        
        .subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 20px;
            font-size: 14px;
        }
        
        .status {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 15px;
            text-align: center;
            border: 2px solid #e9ecef;
            font-weight: 500;
            min-height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .status-getting {
            background: #fff3cd;
            border-color: #ffeaa7;
            color: #856404;
        }
        
        .status-active {
            background: #d4edda;
            border-color: #c3e6cb;
            color: #155724;
        }
        
        .status-error {
            background: #f8d7da;
            border-color: #f5c6cb;
            color: #721c24;
        }
        
        .status-retry {
            background: #cce5ff;
            border-color: #b8daff;
            color: #004085;
        }
        
        .location-box {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 15px;
        }
        
        .coordinate {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            padding-bottom: 12px;
            border-bottom: 1px solid #dee2e6;
        }
        
        .coordinate:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }
        
        .label {
            font-weight: 600;
            color: #495057;
            font-size: 14px;
        }
        
        .value {
            color: #007bff;
            font-weight: 500;
            font-size: 14px;
        }
        
        .buttons {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }
        
        button {
            flex: 1;
            padding: 14px;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .start-btn {
            background: #28a745;
            color: white;
        }
        
        .start-btn:hover {
            background: #218838;
        }
        
        .stop-btn {
            background: #dc3545;
            color: white;
        }
        
        .stop-btn:hover {
            background: #c82333;
        }
        
        .stop-btn:disabled {
            background: #6c757d;
            cursor: not-allowed;
        }
        
        .debug {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 10px;
        }
        
        .debug h3 {
            color: #333;
            margin-bottom: 10px;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .log {
            height: 120px;
            overflow-y: auto;
            padding: 10px;
            background: white;
            border-radius: 5px;
            border: 1px solid #dee2e6;
            font-family: 'Courier New', monospace;
            font-size: 12px;
        }
        
        .log-entry {
            padding: 4px 0;
            border-bottom: 1px solid #f1f3f5;
        }
        
        .log-time {
            color: #6c757d;
        }
        
        .log-message {
            color: #333;
        }
        
        .loading {
            color: #6c757d;
            font-style: italic;
        }
        
        .retry-count {
            color: #007bff;
            font-weight: bold;
        }
        
        .pulse {
            animation: pulse 2s infinite;
        }
        
        .infinite {
            color: #ff6b6b;
            font-weight: bold;
        }
        
        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.7; }
            100% { opacity: 1; }
        }
        
        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 8px;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>📍 Persistent Location Tracker</h1>
        <p class="subtitle">Will keep trying until location is found</p>
        
        <div id="status" class="status">
            Ready to start tracking
        </div>
        
        <div class="buttons">
            <button id="startBtn" class="start-btn">Start Tracking</button>
            <button id="stopBtn" class="stop-btn" disabled>Stop</button>
        </div>
        
        <div class="location-box">
            <div class="coordinate">
                <span class="label">Latitude:</span>
                <span id="latitude" class="value loading">--</span>
            </div>
            <div class="coordinate">
                <span class="label">Longitude:</span>
                <span id="longitude" class="value loading">--</span>
            </div>
            <div class="coordinate">
                <span class="label">Accuracy:</span>
                <span id="accuracy" class="value loading">--</span>
            </div>
            <div class="coordinate">
                <span class="label">Retry Count:</span>
                <span id="retryCount" class="value infinite">∞</span>
            </div>
            <div class="coordinate">
                <span class="label">Last Update:</span>
                <span id="timestamp" class="value loading">--</span>
            </div>
        </div>
        
        <div class="debug">
            <h3>📝 Activity Log</h3>
            <div id="log" class="log">
                <div class="log-entry">
                    <span class="log-time">[System]</span>
                    <span class="log-message">Tracker ready - Will retry forever</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        // State management
        let isTracking = false;
        let watchId = null;
        let updateCount = 0;
        let retryCount = 0;
        let retryDelay = 2000; // Start with 2 seconds
        let currentRetryTimer = null;
        let isInitialLocation = true;
        
        // DOM elements
        const statusEl = document.getElementById('status');
        const startBtn = document.getElementById('startBtn');
        const stopBtn = document.getElementById('stopBtn');
        const latitudeEl = document.getElementById('latitude');
        const longitudeEl = document.getElementById('longitude');
        const accuracyEl = document.getElementById('accuracy');
        const timestampEl = document.getElementById('timestamp');
        const retryCountEl = document.getElementById('retryCount');
        const logEl = document.getElementById('log');
        
        // Check if geolocation is supported
        function checkSupport() {
            if (!navigator.geolocation) {
                statusEl.textContent = "❌ Geolocation not supported";
                statusEl.className = "status status-error";
                startBtn.disabled = true;
                addLog("Error: Geolocation not supported by browser", "error");
                return false;
            }
            return true;
        }
        
        // Add message to log
        function addLog(message, type = "info") {
            const now = new Date();
            const time = now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', second:'2-digit'});
            
            const logEntry = document.createElement('div');
            logEntry.className = 'log-entry';
            
            let color = "#333";
            if (type === "error") color = "#dc3545";
            if (type === "success") color = "#28a745";
            if (type === "retry") color = "#007bff";
            if (type === "warning") color = "#ff9800";
            
            logEntry.innerHTML = `
                <span class="log-time">[${time}]</span>
                <span class="log-message" style="color: ${color}">${message}</span>
            `;
            
            logEl.appendChild(logEntry);
            
            // Keep only last 10 logs
            while (logEl.children.length > 10) {
                logEl.removeChild(logEl.firstChild);
            }
            
            // Auto-scroll
            logEl.scrollTop = logEl.scrollHeight;
        }
        
        // Update display with position data
        function updateDisplay(position) {
            // Update coordinates
            latitudeEl.textContent = position.coords.latitude.toFixed(6);
            longitudeEl.textContent = position.coords.longitude.toFixed(6);
            accuracyEl.textContent = `${Math.round(position.coords.accuracy)} meters`;
            
            // Update timestamp
            const now = new Date();
            timestampEl.textContent = now.toLocaleTimeString();
            
            updateCount++;
            
            // Clear loading styles
            [latitudeEl, longitudeEl, accuracyEl, timestampEl].forEach(el => {
                el.classList.remove("loading");
            });
            
            return now;
        }
        
        // Show loading state
        function showLoading() {
            statusEl.innerHTML = `<span class="spinner"></span>Getting location...`;
            statusEl.className = "status status-getting pulse";
        }
        
        // Clear any pending retry timer
        function clearRetryTimer() {
            if (currentRetryTimer) {
                clearTimeout(currentRetryTimer);
                currentRetryTimer = null;
            }
        }
        
        // Attempt to get location with infinite retry
        function attemptLocationInfiniteRetry() {
            if (!isTracking) return;
            
            clearRetryTimer();
            showLoading();
            
            // Update retry count display
            retryCount++;
            retryCountEl.textContent = retryCount;
            
            // Dynamic retry delay (increases slightly after many retries, then stabilizes)
            let dynamicDelay = retryDelay;
            if (retryCount > 10) dynamicDelay = 3000; // 3 seconds after 10 retries
            if (retryCount > 20) dynamicDelay = 4000; // 4 seconds after 20 retries
            if (retryCount > 30) dynamicDelay = 5000; // 5 seconds after 30 retries (max)
            
            // Clear previous loading states
            if (retryCount === 1) {
                [latitudeEl, longitudeEl, accuracyEl, timestampEl].forEach(el => {
                    el.classList.add("loading");
                    if (el.id !== 'timestamp') el.textContent = "--";
                });
            }
            
            // Get current position
            navigator.geolocation.getCurrentPosition(
                // Success callback
                (position) => {
                    const time = updateDisplay(position);
                    
                    if (isInitialLocation) {
                        statusEl.textContent = "✅ Location found! Starting continuous tracking...";
                        statusEl.className = "status status-active";
                        addLog(`Initial location found after ${retryCount} ${retryCount === 1 ? 'try' : 'tries'}: ${position.coords.latitude.toFixed(4)}, ${position.coords.longitude.toFixed(4)}`, "success");
                        
                        // Start continuous tracking
                        startContinuousTracking();
                        isInitialLocation = false;
                    } else {
                        statusEl.textContent = "📍 Tracking active";
                        statusEl.className = "status status-active";
                        addLog(`Location updated: ${position.coords.latitude.toFixed(4)}, ${position.coords.longitude.toFixed(4)}`);
                    }
                },
                // Error callback - will retry forever
                (error) => {
                    handleLocationError(error, dynamicDelay);
                },
                // Options
                {
                    enableHighAccuracy: true,
                    timeout: 15000,  // 15 second timeout
                    maximumAge: 0
                }
            );
        }
        
        // Handle location errors with infinite retry
        function handleLocationError(error, nextDelay) {
            let errorMsg = "";
            let isFatal = false;
            
            switch(error.code) {
                case 1: // PERMISSION_DENIED
                    errorMsg = "❌ Location permission denied. Please enable location access in browser settings.";
                    isFatal = true;
                    break;
                    
                case 2: // POSITION_UNAVAILABLE
                    errorMsg = `📍 Location unavailable. Retrying in ${nextDelay/1000}s... (Attempt ${retryCount})`;
                    break;
                    
                case 3: // TIMEOUT
                    errorMsg = `⏱️ Location request timed out. Retrying in ${nextDelay/1000}s... (Attempt ${retryCount})`;
                    break;
                    
                default:
                    errorMsg = `❓ Unknown error. Retrying in ${nextDelay/1000}s... (Attempt ${retryCount})`;
            }
            
            if (isFatal) {
                statusEl.textContent = errorMsg;
                statusEl.className = "status status-error";
                addLog("Fatal error: Location permission denied. Cannot continue.", "error");
                stopTracking();
                return;
            }
            
            // Show retry status with attempt count
            statusEl.innerHTML = `<span class="spinner"></span>${errorMsg}`;
            statusEl.className = "status status-retry pulse";
            
            // Log the retry
            if (retryCount <= 5 || retryCount % 5 === 0) { // Log first 5 and every 5th after
                addLog(`Attempt ${retryCount}: ${errorMsg.split('.')[0]}`, "retry");
            }
            
            // Schedule infinite retry
            currentRetryTimer = setTimeout(() => {
                if (isTracking) {
                    attemptLocationInfiniteRetry();
                }
            }, nextDelay);
        }
        
        // Start continuous tracking after initial location is found
        function startContinuousTracking() {
            if (!isTracking || watchId) return;
            
            watchId = navigator.geolocation.watchPosition(
                (position) => {
                    const time = updateDisplay(position);
                    // Log occasional updates
                    if (updateCount % 10 === 0) {
                        addLog(`Update #${updateCount}: ${position.coords.latitude.toFixed(4)}, ${position.coords.longitude.toFixed(4)}`);
                    }
                },
                (error) => {
                    // If continuous tracking fails, fall back to single location requests
                    addLog("Continuous tracking interrupted. Falling back to retry mode...", "warning");
                    clearRetryTimer();
                    
                    // Clear the watch since it failed
                    if (watchId) {
                        navigator.geolocation.clearWatch(watchId);
                        watchId = null;
                    }
                    
                    // Start infinite retry again
                    isInitialLocation = true;
                    retryCount = 0;
                    attemptLocationInfiniteRetry();
                },
                {
                    enableHighAccuracy: true,
                    maximumAge: 5000, // Accept positions up to 5 seconds old
                    timeout: 20000
                }
            );
            
            addLog("Continuous tracking started", "success");
        }
        
        // Start tracking
        function startTracking() {
            if (!checkSupport() || isTracking) return;
            
            isTracking = true;
            startBtn.disabled = true;
            stopBtn.disabled = false;
            updateCount = 0;
            retryCount = 0;
            retryCountEl.textContent = "0";
            retryCountEl.classList.remove("infinite");
            isInitialLocation = true;
            
            addLog("Starting location tracking with INFINITE retry...", "info");
            addLog("Will keep trying until location is found", "info");
            
            attemptLocationInfiniteRetry();
        }
        
        // Stop tracking
        function stopTracking() {
            clearRetryTimer();
            
            if (watchId) {
                navigator.geolocation.clearWatch(watchId);
                watchId = null;
            }
            
            isTracking = false;
            isInitialLocation = true;
            startBtn.disabled = false;
            stopBtn.disabled = true;
            
            statusEl.textContent = "Tracking stopped";
            statusEl.className = "status";
            retryCountEl.textContent = "∞";
            retryCountEl.classList.add("infinite");
            
            addLog("Tracking stopped. Retry count reset to ∞", "info");
        }
        
        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            checkSupport();
            
            // Event listeners
            startBtn.addEventListener('click', startTracking);
            stopBtn.addEventListener('click', stopTracking);
            
            // Handle page visibility changes
            document.addEventListener('visibilitychange', () => {
                if (document.hidden && isTracking) {
                    addLog("Page hidden - tracking continues in background", "info");
                } else if (isTracking) {
                    addLog("Page visible again", "info");
                }
            });
            
            // Add some initial logs
            addLog("This tracker will retry FOREVER until location is found", "info");
            addLog("Perfect for devices that take time to get GPS lock", "info");
        });
    </script>
</body>
</html>
